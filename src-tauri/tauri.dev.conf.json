{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Switch Dev",
  "version": "3.21.0-dev.1",
  "identifier": "com.ccswitch.desktop.dev",
  "build": {
    "devUrl": "http://127.0.0.1:3100",
    "beforeDevCommand": "pnpm exec vite --host 127.0.0.1 --port 3100 --strictPort"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ccswitch-dev"]
      }
    },
    "updater": {
      "endpoints": []
    }
  }
}
